{
  "settings": {
    "analysis": {
      "tokenizer": {
        "non_alphanumeric_splitter": {
          "type": "pattern",
          "pattern": "[^\\p{L}\\p{N}]+"
        }
      },
      "filter": {
        "autocomplete_ngram": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 15
        }
      },
      "analyzer": {
        "autocomplete": {
          "type": "custom",
          "tokenizer": "non_alphanumeric_splitter",
          "filter": [
            "lowercase",
            "autocomplete_ngram"
          ]
        },
        "autocomplete_search": {
          "type": "custom",
          "tokenizer": "non_alphanumeric_splitter",
          "filter": [
            "lowercase"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "userId": {
        "type": "long"
      },
      "name": {
        "type": "text",
        "analyzer": "autocomplete",
        "search_analyzer": "autocomplete_search"
      },
      "thumbnail": {
        "type": "text"
      }
    }
  }
}
